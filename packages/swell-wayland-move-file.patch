+BOOL MoveFile(const char *existing_filename, const char *new_filename)
+{
+  // Match Windows semantics: do not overwrite an existing destination,
+  // except when both paths identify the same file (for example, a
+  // case-only rename on a case-insensitive filesystem).
+  struct stat destination_stat, source_stat;
+  if (!stat(new_filename, &destination_stat))
+  {
+    if (stat(existing_filename, &source_stat)) return false;
+    if (source_stat.st_dev != destination_stat.st_dev ||
+        source_stat.st_ino != destination_stat.st_ino) return false;
+  }
+
+  return rename(existing_filename, new_filename) == 0;
+}
