+static std::string jsonString(const std::string &input)
+{
+  static const char hex[] = "0123456789abcdef";
+  std::string output{'"'};
+
+  for(const unsigned char character : input) {
+    switch(character) {
+    case '"': output += "\\\""; break;
+    case '\\': output += "\\\\"; break;
+    case '\b': output += "\\b"; break;
+    case '\f': output += "\\f"; break;
+    case '\n': output += "\\n"; break;
+    case '\r': output += "\\r"; break;
+    case '\t': output += "\\t"; break;
+    default:
+      if(character < 0x20) {
+        output += "\\u00";
+        output += hex[character >> 4];
+        output += hex[character & 0xf];
+      }
+      else
+        output += character;
+    }
+  }
+
+  output += '"';
+  return output;
+}
+
+bool ReaPack::exportState()
+{
+  try {
+    const Registry registry(Path::REGISTRY.prependRoot());
+    time_t registryModifiedAt{};
+    FS::mtime(Path::REGISTRY, &registryModifiedAt);
+
+    std::ostringstream json;
+    json << "{\n  \"formatVersion\": 1,\n"
+         << "  \"generatedAt\": " << time(nullptr) << ",\n"
+         << "  \"registryModifiedAt\": " << registryModifiedAt << ",\n"
+         << "  \"resourcePath\": " << jsonString(Path::root().join()) << ",\n"
+         << "  \"packages\": [";
+
+    bool first = true;
+    for(const Registry::Entry &entry : registry.getEntries()) {
+        json << (first ? "\n" : ",\n")
+             << "    {\"repository\": " << jsonString(entry.remote)
+             << ", \"category\": " << jsonString(entry.category)
+             << ", \"name\": " << jsonString(entry.package)
+             << ", \"version\": " << jsonString(entry.version.toString())
+             << ", \"flags\": " << entry.flags << "}";
+        first = false;
+    }
+    json << (first ? "" : "\n") << "  ]\n}\n";
+
+    const TempPath snapshot(Path::DATA + "reaper-flake-state.json");
+    if(!FS::write(snapshot.temp(), json.str()))
+      return false;
+    if(!FS::rename(snapshot)) {
+      FS::remove(snapshot.temp());
+      return false;
+    }
+    return true;
+  }
+  catch(const reapack_error &) {
+    return false;
+  }
+}
